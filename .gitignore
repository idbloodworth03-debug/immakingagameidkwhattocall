# Godot cache and generated files
.godot/
/game/android/

# Export output
/builds/
*.apk
*.aab
*.ipa

# Signing keys - never commit these
*.keystore
*.jks
*.p12
*.mobileprovision
export_credentials.cfg

# OS junk
.DS_Store
Thumbs.db

# Local web builds (the GitHub workflow builds and publishes the web version)
/build/
__pycache__/

# Work files while tools/creatures renders an animal
game/art/units/*/_*

# Written by tools/build_web.sh: which build this is (shown in the game)
/game/build.json

# Art packs under a store license stay on your computer (tools/packs): only
# CC0 sources (art_sources/quaternius) are part of the repository.
/art_sources/*
!/art_sources/quaternius/

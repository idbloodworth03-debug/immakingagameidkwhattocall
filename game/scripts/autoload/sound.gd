extends Node
## Plays sound effects and music. Every sound is generated by
## tools/make_sounds.py. Players can switch sound and music off in their
## profile (saved in Profile.data.settings).

const SFX_NAMES := [
	"tap", "select", "error", "coin", "upgrade", "pop", "rattle", "reveal", "new_card",
	"release", "tool", "horn", "heal", "hit", "zap", "tower_hit", "death", "boom",
	"alert", "tick", "victory", "defeat",
]
const PLAYER_COUNT := 10
## The same sound can't start again within this many seconds, so a big fight
## doesn't turn into noise.
const MIN_GAP := 0.06

var _streams := {}
var _players: Array = []
var _next_player := 0
var _last_played := {}
var _music: AudioStreamPlayer
var _music_name := ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for sfx in SFX_NAMES:
		_streams[sfx] = load("res://audio/sfx/%s.wav" % sfx)
	for i in PLAYER_COUNT:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)
	_music = AudioStreamPlayer.new()
	_music.volume_db = -9.0
	add_child(_music)


func sound_on() -> bool:
	return Profile.data.get("settings", {}).get("sound", true)


func music_on() -> bool:
	return Profile.data.get("settings", {}).get("music", true)


## Plays a sound effect. `pitch_spread` adds a little random pitch so repeated
## sounds (like hits) don't sound robotic.
func play(sfx: String, volume_db := 0.0, pitch_spread := 0.0) -> void:
	if not sound_on() or not _streams.has(sfx):
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(sfx, -10.0)) < MIN_GAP:
		return
	_last_played[sfx] = now
	var player: AudioStreamPlayer = _players[_next_player]
	_next_player = (_next_player + 1) % _players.size()
	player.stream = _streams[sfx]
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_spread, pitch_spread)
	player.play()


## Starts a looping music track ("menu" or "battle"), unless it's already playing.
func play_music(track: String) -> void:
	_music_name = track
	if not music_on():
		_music.stop()
		return
	if _music.playing and _music.stream != null and _music.stream.resource_path.ends_with(track + ".wav"):
		return
	var stream: AudioStreamWAV = load("res://audio/music/%s.wav" % track)
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)
	_music.stream = stream
	_music.play()


func stop_music() -> void:
	_music.stop()


func set_sound(enabled: bool) -> void:
	_set_setting("sound", enabled)


func set_music(enabled: bool) -> void:
	_set_setting("music", enabled)
	if enabled:
		play_music(_music_name if _music_name != "" else "menu")
	else:
		_music.stop()


func _set_setting(key: String, enabled: bool) -> void:
	if not Profile.data.has("settings"):
		Profile.data.settings = {}
	Profile.data.settings[key] = enabled
	Profile.save()
